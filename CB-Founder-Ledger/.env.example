# Copy to .env and fill in. NEVER commit .env.
# Generate secrets with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"

NODE_ENV=development

# --- API ---
PORT=4000
# Local dev (Mongo on your machine / `docker run -p 27017:27017 mongo:7`):
MONGO_URI=mongodb://127.0.0.1:27017/cb_founder_ledger
# At least 32 characters, random, unique per environment.
JWT_ACCESS_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
# Browser origin allowed by CORS / origin check (the URL founders open).
CLIENT_ORIGIN=http://localhost:5173
# Defaults to true in production. Must stay true behind HTTPS.
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (needed for correct client IPs / rate limiting).
TRUST_PROXY=0
BCRYPT_COST=12
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MINUTES=15

# --- Phase 2: transactions & receipts ---
# Currency is configuration only; amounts are stored as integers of minor units (paise/cents).
CURRENCY_CODE=INR
CURRENCY_MINOR_UNITS=2
# Private receipt storage directory (local dev). In Docker this is the `receipts-data` volume at /data/receipts.
RECEIPT_STORAGE_DIR=./data/receipts
RECEIPT_MAX_BYTES=5242880
WRITE_RATE_LIMIT_MAX=120
UPLOAD_RATE_LIMIT_MAX=30

# --- First admin (used only by `npm run seed:admin`; creates no financial data) ---
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin

# --- Docker Compose only ---
MONGO_ROOT_USERNAME=cbroot
MONGO_ROOT_PASSWORD=
# Host ports
WEB_PORT=8080
