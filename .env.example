# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# In production this should be your real domain, e.g. https://careerbuddies.in
# (used to build the Dodo Payments return_url / cancel_url).
APP_URL="MY_APP_URL"

# ---- Dodo Payments (career program checkout) ----
# Secret bearer token from your Dodo Payments dashboard (Developers > API Keys).
# NEVER commit a real value here or paste it in chat — set it directly in your
# hosting provider's environment variables / secrets.
DODO_PAYMENTS_API_KEY=""

# Webhook signing secret from Dodo Payments (Developers > Webhooks), used to
# verify that payment.succeeded events genuinely came from Dodo.
DODO_PAYMENTS_WEBHOOK_KEY=""

# "test" (default, safe) or "live". Only set to "live" once you're ready to
# accept real payments.
DODO_PAYMENTS_ENV="test"

# Product ids for each program. Run `npm run setup:dodo` once (with
# DODO_PAYMENTS_API_KEY set) to auto-create these three products and print/
# append the ids below, or paste them in manually after creating the products
# yourself in the Dodo dashboard.
DODO_EXPLORE_PRODUCT_ID=""
DODO_ELEVATE_PRODUCT_ID=""
DODO_EXCEL_PRODUCT_ID=""

# ---- Transactional email (Resend) ----
# API key from https://resend.com/api-keys
RESEND_API_KEY=""

# Sender identity. The domain must be verified in Resend before this works.
EMAIL_FROM="CareerBuddies <hello@careerbuddies.in>"

# ---- Existing WhatsApp / Google Sheets lead sync (optional) ----
# NOTIFY_WHATSAPP_NUMBERS="+91XXXXXXXXXX,+91XXXXXXXXXX"
# WHATSAPP_API_URL=""
# WHATSAPP_API_TOKEN=""
# APPS_SCRIPT_WEBHOOK_URL=""
